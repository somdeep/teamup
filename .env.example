# Leave both blank to run the signup mockup without an Auth project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Origin for email links. Set the public site origin in production.
TEAMUP_SITE_URL=http://localhost:3000

# Optional Fetch AI interpretation. With no key, Fetch keeps using its
# deterministic parser. Never expose this key through NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
FETCH_OPENAI_MODEL=gpt-4o-mini
# Keep deterministic until a server-side key is configured. Use ai-first for the
# AI demo; switch back to deterministic for instant rollback.
FETCH_INTERPRETATION_MODE=deterministic
